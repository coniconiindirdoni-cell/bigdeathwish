const ANTIQUES = [
  { key: 'vaz',      name: 'Eski Vazo',      emoji: '🏺', rarity: 'normal',   price: 4600,  xpBonus: 5,  coinBonus: 5,  dailyBonus: 0  },
  { key: 'saat',     name: 'Eskitme Saat',   emoji: '⏰', rarity: 'normal',   price: 4600,  xpBonus: 5,  coinBonus: 5,  dailyBonus: 0  },
